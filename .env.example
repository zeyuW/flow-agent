# ── LLM Provider API Keys ───────────────────────────────────────────────────────
# 主模型配置（用于主要推理任务）
DEEPSEEK_API_KEY=your-deepseek-api-key
QWEN_API_KEY=your-qwen-api-key

# ── Optional: Third-party Services ───────────────────────────────────────────────
# Serper API Key (Google Search) - https://serper.dev
# SERPER_API_KEY=your-serper-api-key

# Tavily API Key (Web Search)
# TAVILY_API_KEY=your-tavily-api-key

# Embedding Model (阿里云 text-embedding-v3)

# QQBot
QQBOT_APP_ID=你的app_id
QQBOT_TOKEN=你的bot_token
QQBOT_SECRET=你的client_secret

# ── Optional: Monitoring & Debugging ─────────────────────────────────────────────
# Enable LangSmith to monitor and debug your LLM calls
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_PROJECT=flow-agent

# ── Optional: GitHub Integration ────────────────────────────────────────────────
# GitHub API Token (for file operations)
# GITHUB_TOKEN=your-github-token

# ── Optional: Database Configuration ─────────────────────────────────────────────
# Only needed when using PostgreSQL instead of SQLite
# DATABASE_URL=postgresql://user:password@localhost:5432/flow_agent

# ── Optional: External Config File ──────────────────────────────────────────────
# Path to external TOML config file (overrides .env settings)
# FLOW_AGENT_CONFIG_FILE=/path/to/config.toml
