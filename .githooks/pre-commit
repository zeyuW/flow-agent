#!/usr/bin/env bash
set -euo pipefail

# 提交前只执行验证，不负责自动提交，避免 Git hook 递归调用。
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${ROOT_DIR}"

export PYTHONPATH="${ROOT_DIR}/backend/src${PYTHONPATH:+:${PYTHONPATH}}"

python -m compileall -q backend/src
git diff --check
python -m pytest -q backend/tests
