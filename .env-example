# ==============================================
# 【项目全局配置】所有系统级配置
# ==============================================
FLOW_AGENT_MEMORY_DB_PATH=.flow_agent/memory.db
FLOW_AGENT_LOG_LEVEL=INFO
FLOW_AGENT_DEFAULT_SESSION=default
FLOW_AGENT_TOOLS_ENABLED=true
FLOW_AGENT_MAX_TOOL_STEPS=5
FLOW_AGENT_RETRIEVAL_ENABLED=true
FLOW_AGENT_RETRIEVAL_MAX_ITEMS=6
FLOW_AGENT_OBSERVE_ENABLED=true
FLOW_AGENT_TRACE_PATH=.flow_agent/trace.jsonl
FLOW_AGENT_MEMORY_POLICY_ENABLED=true
FLOW_AGENT_MEMORY_MAX_MESSAGES=200
FLOW_AGENT_MEMORY_DEDUPE=true
FLOW_AGENT_PROACTIVE_ENABLED=false
FLOW_AGENT_PROACTIVE_INTERVAL_SECONDS=60
FLOW_AGENT_PROACTIVE_COOLDOWN_SECONDS=300
FLOW_AGENT_PROACTIVE_DEDUP_TTL_SECONDS=86400
FLOW_AGENT_PROACTIVE_SOURCE_FILE=.flow_agent/proactive_items.txt
FLOW_AGENT_PROACTIVE_TODO_FILE=.flow_agent/todo_items.txt
FLOW_AGENT_PROACTIVE_TASKS_FILE=.flow_agent/tasks.txt
FLOW_AGENT_PROACTIVE_MIN_PRIORITY_TO_SEND=0.5

# ==============================================
# 【大模型配置】所有AI模型相关
# ==============================================
LLM_MODEL=deepseek-chat
LLM_API_KEY=xxx
LLM_BASE_URL=https://api.deepseek.com
LLM_SYSTEM_PROMPT=You are a helpful assistant.